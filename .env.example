# =================================
# VARIABLES D'ENVIRONNEMENT REQUISES
# =================================
# Copiez ce fichier vers .env.local pour le développement local
# Configurez ces variables dans Vercel pour la production

# ---------------------------------
# BASE DE DONNÉES (OBLIGATOIRE)
# ---------------------------------
# Pour développement local (SQLite)
DATABASE_URL="file:./dev.db"

# Pour production avec Turso (décommentez et configurez)
# DATABASE_URL="libsql://[your-database].turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..."

# ---------------------------------
# AUTHENTIFICATION (OPTIONNEL)
# ---------------------------------
# Configuration mono-utilisateur (si utilisé)
APP_USERNAME="quentin"
APP_PASSWORD="your_secure_password_here"

# Secret de session (générer une chaîne aléatoire d'au moins 32 caractères)
SESSION_SECRET="your_random_secret_string_here_change_in_production"

# ---------------------------------
# GOOGLE OAUTH (OPTIONNEL)
# ---------------------------------
# Configuration pour l'authentification Google et les intégrations
# Obtenez vos identifiants sur: https://console.cloud.google.com/apis/credentials
# 1. Créez un projet Google Cloud
# 2. Activez l'API Google+ et autres APIs (Fit, Calendar, Drive)
# 3. Créez des identifiants OAuth 2.0
# 4. Ajoutez les URIs de redirection autorisées:
#    - http://localhost:3000/api/auth/google/callback (développement)
#    - https://votre-domaine.com/api/auth/google/callback (production)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# URL de l'application (optionnel, utilisé pour les redirections OAuth)
# En développement: http://localhost:3000
# En production: https://votre-domaine.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------
# COACH IA - OpenAI (OPTIONNEL)
# ---------------------------------
# Clé API OpenAI pour le coach IA et les messages de motivation
# Si non configuré, les messages de fallback seront utilisés
# Obtenez votre clé sur: https://platform.openai.com/api-keys
# IMPORTANT: Nécessite des crédits sur le compte OpenAI (minimum 5$)
OPENAI_API_KEY="sk-proj-..."

# ---------------------------------
# NOTIFICATIONS PUSH (OPTIONNEL)
# ---------------------------------
# Clés VAPID pour les notifications push Web
# Générez-les avec: npx web-push generate-vapid-keys

# Clé publique VAPID (exposée au client)
# Cette clé est publique et sera visible dans le code client
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BKdGP3DpzRPcV8ZkN0Q07PDyPs0T3ucWUbs7HtNrOamEQziq_FQwB3s_kdRtg9zeQfPfEZjlL1aRViKXjkz4Xag"

# Clé privée VAPID (GARDER SECRÈTE - côté serveur uniquement)
# NE JAMAIS commit cette clé dans Git ou l'exposer au client
VAPID_PRIVATE_KEY="ixIZeMRdnzw_gBGu29C4RSo2sqeDOYyUn1RWgtq6hU0"

# Email de contact pour les notifications push
VAPID_EMAIL="mailto:votre-email@example.com"

# ---------------------------------
# NOTES IMPORTANTES
# ---------------------------------
# Variables commençant par NEXT_PUBLIC_ :
#   - Exposées au client (navigateur)
#   - Visibles dans le code source compilé
#   - Exemples: NEXT_PUBLIC_VAPID_PUBLIC_KEY
#
# Autres variables :
#   - Accessibles uniquement côté serveur
#   - Jamais exposées au client
#   - Exemples: OPENAI_API_KEY, VAPID_PRIVATE_KEY, DATABASE_AUTH_TOKEN
#
# Pour plus de détails sur la configuration, consultez CONFIGURATION.md
