// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modèle pour suivre chaque entrée de journal d'addiction
model Entry {
  id                    String   @id @default(cuid())
  date                  DateTime
  time                  String   // Format HH:mm
  hasSmoked             Boolean
  jointCount            Int      @default(0)
  jointTime             String?  // Heure du joint si différente
  minutesSinceLastJoint Int?
  cravingLevel          Int      // 0-10
  emotionalState        String   @default("")
  physicalState         String   @default("")
  context               String   @default("")
  trigger               String   @default("")
  alternativeAction     String   @default("")
  consciousDecision     Boolean  @default(false)
  comment               String   @default("")

  // Gestion Adrénaline (discret)
  adrenalineEvent       Boolean  @default(false)
  adrenalineType        String   @default("") // "risque", "échappatoire", "alternative"
  adrenalineTrigger     String   @default("") // Routine, Stimulation, Transgression, Procrastination, Vide, Solitude, Stress
  adrenalineAlternative String   @default("") // Quelle alternative a été testée
  adrenalineOutcome     String   @default("") // "réussi", "réduit", "échoué"

  // Gestion Isolement (discret)
  isolationEvent        Boolean  @default(false)
  isolationPlanned      Boolean  @default(false) // Avais-tu un plan/activité ?
  isolationActivity     String   @default("") // Quelle activité prévue/faite
  isolationReason       String   @default("") // "choix", "fuite", "autre"
  isolationOutcome      String   @default("") // "rechargé", "neutre", "addictions"

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([date])
  @@index([adrenalineEvent])
  @@index([isolationEvent])
}

// Modèle pour les objectifs journaliers
model DailyGoal {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  maxJoints           Int      // Nombre maximum de joints autorisés
  minIntervalMinutes  Int      // Intervalle minimum entre joints (en minutes)
  note                String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}

// Modèle pour les stratégies personnalisées activées par l'utilisateur
model ActiveStrategy {
  id          String   @id @default(cuid())
  strategyId  String   // ID de la stratégie (morning_routine, stress_management, etc.)
  title       String
  description String
  category    String   // morning, evening, stress, emotional, social
  isActive    Boolean  @default(true)
  activatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([strategyId])
  @@index([isActive])
}

// Modèle pour le suivi de discipline et responsabilité personnelle
model DisciplineEntry {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  wakeUpTime          String?  // Heure de réveil réelle
  sleepTime           String?  // Heure de coucher réelle
  exerciseDone        Boolean  @default(false)
  exerciseDuration    Int      @default(0) // En minutes
  productiveHours     Int      @default(0) // Heures vraiment productives
  distractionsResisted Int     @default(0) // Nombre de fois où tu as résisté
  promisesKept        Int      @default(0) // Promesses tenues sur X
  selfRating          Int      @default(5) // Auto-évaluation 0-10
  worstMoment         String   @default("") // Le pire moment de ta journée
  bestMoment          String   @default("") // Le meilleur moment
  tomorrowCommitment  String   @default("") // Engagement pour demain
  excuses             String   @default("") // Tes excuses d'aujourd'hui
  truthfulReflection  String   @default("") // Réflexion brutalement honnête
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}

// Modèle pour les souscriptions aux notifications push
model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([endpoint])
}

// Modèle pour noter des pensées avec horodatage
model Thought {
  id        String   @id @default(cuid())
  content   String   // La pensée en elle-même
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Modèle pour tracker les lectures
model Reading {
  id          String   @id @default(cuid())
  title       String   // Titre du livre
  author      String   // Auteur
  category    String   // stoïcisme, psychologie, discipline, etc.
  description String   // Pourquoi ce livre
  priority    Int      @default(0) // 0=normal, 1=top priority
  status      String   @default("non_commencé") // non_commencé, en_cours, terminé
  notes       String   @default("") // Notes personnelles
  startedAt   DateTime? // Date de début de lecture
  finishedAt  DateTime? // Date de fin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

// Modèle pour les tâches
model TaskItem {
  id             String   @id @default(cuid())
  title          String
  description    String   @default("")
  type           String   // ponctuelle, quotidienne
  priority       String   @default("normale")
  category       String   @default("Personnel")
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  dueDate        DateTime?
  lastCompleted  DateTime?
  daysNotCompleted Int    @default(0)
  isFromHabit    Boolean  @default(false)
  habitId        String?
  updatedAt      DateTime @updatedAt

  @@index([completed])
  @@index([type])
  @@index([category])
}

// Modèle pour les Habitudes Atomiques (James Clear)
model AtomicHabit {
  id          String   @id @default(cuid())

  // STEP 1: Make it Obvious (Rendre évident)
  name        String   // L'habitude en elle-même
  trigger     String   // "Je vais [habitude] QUAND [trigger]"
  identity    String   // "Pour que je devienne [identity]"
  stackAfter  String?  // Habit stacking: après quelle habitude existante ?
  visualCue   String?  // Rappel visuel (ex: "chaussures devant la porte")

  // STEP 2: Make it Attractive (Rendre attractif)
  reward      String?  // Récompense immédiate associée
  pleasure    String?  // Élément plaisant pendant l'habitude (podcast, musique, etc.)

  // STEP 3: Make it Easy (Rendre facile)
  difficulty  String   @default("easy") // easy, medium, hard
  preparation String?  // Ce qui est prêt pour faciliter (ex: "tenue de sport sur la chaise")
  duration    Int      @default(5) // Durée en minutes

  // STEP 4: Make it Satisfying (Rendre satisfaisant)
  trackingMethod String @default("checkbox") // checkbox, counter, timer, yes_no

  // Métadonnées
  category    String   @default("general") // sport, meditation, alimentation, lecture, créativité, social
  isActive    Boolean  @default(true)
  isPositive  Boolean  @default(true) // true=bonne habitude à prendre, false=mauvaise à arrêter

  // Pour remplacer l'addiction
  replacesAddiction Boolean @default(false) // Est-ce une alternative au joint ?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation avec les complétions quotidiennes
  completions HabitCompletion[]

  @@index([isActive])
  @@index([category])
  @@index([replacesAddiction])
}

// Modèle pour tracker les complétions quotidiennes d'habitudes
model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  habit       AtomicHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date        DateTime // Date de la complétion
  completed   Boolean  @default(false)
  value       Int?     // Pour les habitudes comptées (ex: nombre de pages lues)
  duration    Int?     // Durée réelle en minutes

  // Notes et contexte
  note        String   @default("") // Comment s'est passée l'habitude
  difficulty  String?  // "facile", "moyen", "difficile"
  mood        String?  // Comment tu te sentais après

  // Récompense obtenue
  rewardClaimed Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
  @@index([completed])
}

// Modèle pour les badges et récompenses
model Badge {
  id          String   @id @default(cuid())
  name        String   // Nom du badge
  description String   // Description
  icon        String   // Emoji ou icon
  category    String   // streak, milestone, achievement

  // Critères d'obtention
  requirement String   // Description du critère
  requiredValue Int    // Valeur requise (ex: 7 jours de streak)

  // Métadonnées
  earnedAt    DateTime? // Quand le badge a été obtenu (null = pas encore obtenu)
  isUnlocked  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isUnlocked])
}

// Modèle pour les dépenses récurrentes (prévisions bancaires)
model RecurringExpense {
  id             String   @id @default(cuid())
  label          String   // Ex: "Crédit immobilier", "EDF", etc.
  amount         Float    // Montant en euros
  dayOfMonth     Int      // Jour du mois (1-31)
  frequency      String   @default("mensuel") // mensuel, bimensuel, annuel
  category       String   @default("Autre") // Crédit, Assurance, Abonnement, Énergie, Autre

  // Dates de validité
  startDate      DateTime? // Quand la dépense commence
  endDate        DateTime? // Quand la dépense se termine (optionnel, pour prélèvements temporaires)

  // Gestion des variations
  isVariable     Boolean  @default(false) // True pour dépenses variables comme EDF
  variableMonths String?  // JSON: {"1": 238, "2": 150} pour janvier=238€, autres=150€

  // Métadonnées
  isActive       Boolean  @default(true) // Permet de désactiver sans supprimer
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dayOfMonth])
  @@index([isActive])
  @@index([category])
}

model AchatTest {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  produit     String
  prix        String?
  categorie   String?
  imageUrl    String?
  reponses    String
  score       Int
  decision    String
  utilisateur String   @default("moi")
}

// Modèle pour le solde automatique récupéré depuis Gmail (emails Caisse d'Épargne)
model EmailSolde {
  id              String   @id @default(cuid())
  userId          String   // Email de l'utilisateur (session)

  // Données extraites de l'email
  solde           Float                    // 938.12
  soldeRaw        String                   // "+938,12 €"

  // Opération associée (optionnel)
  operationLabel  String?                  // "EDF"
  operationMontant Float?                  // -404.21
  operationDate   String?                  // "16 janvier 2026"

  // Métadonnées email
  emailId         String   @unique         // Gmail message ID (pour éviter doublons)
  emailDate       DateTime                 // Date réception email
  expediteur      String                   // Validation expéditeur

  // Audit
  fetchedAt       DateTime @default(now()) // Date récupération
  createdAt       DateTime @default(now())

  // Index pour performance
  @@index([userId, emailDate])
  @@index([fetchedAt])
}
