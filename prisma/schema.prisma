// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modèle pour suivre chaque entrée de journal d'addiction
model Entry {
  id                    String   @id @default(cuid())
  date                  DateTime
  time                  String   // Format HH:mm
  hasSmoked             Boolean
  jointCount            Int      @default(0)
  jointTime             String?  // Heure du joint si différente
  minutesSinceLastJoint Int?
  cravingLevel          Int      // 0-10
  emotionalState        String   @default("")
  physicalState         String   @default("")
  context               String   @default("")
  trigger               String   @default("")
  alternativeAction     String   @default("")
  consciousDecision     Boolean  @default(false)
  comment               String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([date])
}

// Modèle pour les objectifs journaliers
model DailyGoal {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  maxJoints           Int      // Nombre maximum de joints autorisés
  minIntervalMinutes  Int      // Intervalle minimum entre joints (en minutes)
  note                String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}

// Modèle pour les stratégies personnalisées activées par l'utilisateur
model ActiveStrategy {
  id          String   @id @default(cuid())
  strategyId  String   // ID de la stratégie (morning_routine, stress_management, etc.)
  title       String
  description String
  category    String   // morning, evening, stress, emotional, social
  isActive    Boolean  @default(true)
  activatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([strategyId])
  @@index([isActive])
}

// Modèle pour le suivi de discipline et responsabilité personnelle
model DisciplineEntry {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  wakeUpTime          String?  // Heure de réveil réelle
  sleepTime           String?  // Heure de coucher réelle
  exerciseDone        Boolean  @default(false)
  exerciseDuration    Int      @default(0) // En minutes
  productiveHours     Int      @default(0) // Heures vraiment productives
  distractionsResisted Int     @default(0) // Nombre de fois où tu as résisté
  promisesKept        Int      @default(0) // Promesses tenues sur X
  selfRating          Int      @default(5) // Auto-évaluation 0-10
  worstMoment         String   @default("") // Le pire moment de ta journée
  bestMoment          String   @default("") // Le meilleur moment
  tomorrowCommitment  String   @default("") // Engagement pour demain
  excuses             String   @default("") // Tes excuses d'aujourd'hui
  truthfulReflection  String   @default("") // Réflexion brutalement honnête
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}

// Modèle pour les souscriptions aux notifications push
model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([endpoint])
}
